# ===== LLM Provider Configuration =====
# Supported providers: groq, gemini, ollama, openai, huggingface, lmstudio
LLM_PROVIDER=groq

# ---- GROQ (cloud, FREE, ultra-fast ~2s responses) ---- RECOMMENDED
# Get free API key: https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your-key-here
# LLM_MODEL=llama-3.1-8b-instant

# ---- GEMINI (cloud, FREE tier, fast) ----
# Get free API key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-key-here
# LLM_MODEL=gemini-2.0-flash-lite

# ---- OLLAMA (local, free, slower on CPU) ----
# Install: https://ollama.com  then run: ollama pull llama3.1:8b
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1

# ---- OPENAI (cloud, paid) ----
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# ---- HUGGINGFACE (cloud, open-source models) ----
# LLM_PROVIDER=huggingface
# LLM_API_KEY=hf_your-token-here
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ---- LM STUDIO (local, GUI-based) ----
# LLM_PROVIDER=lmstudio
# LLM_MODEL=local-model
# LLM_BASE_URL=http://localhost:1234/v1

# ===== Fallback Chain =====
# Comma-separated list of fallback providers (tried in order if primary fails)
# LLM_FALLBACK_PROVIDERS=groq,ollama

# ===== Demo Mode =====
# Set to true for simulated responses (no LLM needed)
DEMO_MODE=false
